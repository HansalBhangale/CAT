# Copy this file to .env.local and paste your MongoDB Atlas connection string.
# Atlas -> Connect -> Drivers -> copy the URI. Replace <password> with your DB user password.
# Make sure to add a database name (e.g. /cat2026) before the "?".

MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cat2026?retryWrites=true&w=majority"
